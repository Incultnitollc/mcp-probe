{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Incultnitollc/mcp-probe",
  "description": "Inspect and score any MCP server 0-100 on publishability, schema and protocol before publish.",
  "version": "1.2.0",
  "repository": {
    "url": "https://github.com/incultnitollc/mcp-probe",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@incultnitollc/mcp-probe",
      "version": "1.2.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
